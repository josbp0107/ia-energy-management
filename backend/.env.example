APP_PORT=8080

# Origen permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
# debug | release
GIN_MODE=debug

# Pausa entre pasos de Run AI Analysis (ms)
ANALYSIS_STEP_DELAY_MS=700

# Datos (solo cmd/seed)
DATA_DIR=../data

# DB
DB_HOST=localhost
DB_PORT=5433
DB_USER=energy_user
DB_PASSWORD=here_password
DB_NAME=energy_management
DB_SSLMODE=disable

# IA (Anthropic). Si ANTHROPIC_API_KEY está vacía se usa la plantilla determinista.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=60

# Usuario demo para el login
DEMO_EMAIL=demo@bia.app
DEMO_PASSWORD=change_me
DEMO_NAME=Bia Demo
